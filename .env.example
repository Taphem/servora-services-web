# Servora Services Web — environment variables
#
# Copy this file to .env.local for local overrides:
#   cp .env.example .env.local
#
# Only NEXT_PUBLIC_-prefixed variables belong in this file. Anything
# without that prefix would be server-only and must never hold a secret
# that also needs client access — Next.js inlines NEXT_PUBLIC_* values
# into the browser bundle at build time, so never put credentials, API
# keys, gateway secrets, or database URLs behind that prefix.

# Public site origin, used for absolute URLs in metadata (Open Graph,
# canonical links). Defaults to the production domain when unset.
NEXT_PUBLIC_SITE_URL=https://servora.hemandu.com

# The Servora API Gateway origin. The browser only ever calls this —
# never servora-services (or any other downstream service) directly.
# Local development should point at a locally running gateway
# (see servora-api-gateway, default port 8080). Production must use
# the public gateway domain, https://api.servora.hemandu.com — never a
# Render-internal *.onrender.com URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
